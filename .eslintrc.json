{
  "env": {
      "browser": true,
      "es2021": true
  },
  "extends": [
      "plugin:react/recommended"
      
  ],
  "overrides": [
      {
          "files": ["*.jsx"]
      }
  ],
  "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module",
      "ecmaFeatures": {
          "jsx": true
      }
  },
  "plugins": [
      "react"
  ],
  "rules": {
      "react/prop-types": "off",
      "no-unused-vars": "warn",
      "no-undef": "error",
      "react/react-in-jsx-scope": "off"
  }
}